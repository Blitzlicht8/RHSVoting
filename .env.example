# ─────────────────────────────────────────────────────────────────────────────
# RHS E-Voting — environment variables
#
# Copy this file to ".env.local" and fill in the values:
#     cp .env.example .env.local        (Mac / Linux / Git Bash)
#     copy .env.example .env.local      (Windows CMD)
#
# .env.local is IGNORED by git on purpose — never commit real secrets.
# Only APP_DATABASE_URL is REQUIRED. Everything else has a safe default or is
# only needed for a specific feature (see notes below).
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED: PostgreSQL database ────────────────────────────────────────────
# The app connects to a PostgreSQL database (we use Supabase, but any Postgres
# works). Paste the full connection string here. The tables and the default
# admin account are created AUTOMATICALLY the first time you open the app.
#
# Supabase: Project → Settings → Database → Connection string → "URI".
# Use the pooled connection (port 6543) if available. SSL is handled for you.
APP_DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres

# ── RECOMMENDED: session secret ──────────────────────────────────────────────
# Signs the login cookie (JWT). Works without it in development (a built-in
# dev value is used), but set your own long random string for real security.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ── OPTIONAL: email for OTP codes (Two-Factor Authentication) ─────────────────
# If these are left blank, the app runs in "no-email" dev mode: the one-time
# code is returned in the API response instead of being emailed, so you can
# still log in while testing. Fill these to actually send OTP emails.
# For Gmail, use an "App Password", not your normal password.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# ── OPTIONAL: file uploads (Vercel Blob) ─────────────────────────────────────
# Needed only to upload images/videos (ID photos, avatars, candidate photos,
# post media). Without it the app runs, but uploads will fail. Get a token from
# a Vercel project → Storage → Blob. Leave blank if you don't need uploads.
BLOB_READ_WRITE_TOKEN=

# ── OPTIONAL: connection pool size ───────────────────────────────────────────
# Max simultaneous DB connections per server instance. Default is 3.
PG_POOL_MAX=3
